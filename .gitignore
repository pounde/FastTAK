# =============================================================================
# Environment & Secrets
# =============================================================================
.env
*.pem
*.p12
*.jks
*.key

# =============================================================================
# TAK Server release and application directory
# =============================================================================
/tak/
*.zip

# =============================================================================
# Backups (encrypted tarballs + age identity live here at runtime).
# The directory itself is tracked (via .gitkeep) so first-time `just up`
# has a bind-mount target — otherwise docker creates it as root-owned.
# =============================================================================
/backups/*
!/backups/.gitkeep

# =============================================================================
# Plans (local working docs, not shipped)
# =============================================================================
docs/plans/

# =============================================================================
# Generated docs (built at mkdocs build time from source XML)
# =============================================================================
docs/reference/cot-types.md

# =============================================================================
# Python (https://github.com/github/gitignore/blob/main/Python.gitignore)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
ENV/
env/
.python-version
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.log
.mypy_cache/
.ruff_cache/
.pytype/

# =============================================================================
# Docker (https://github.com/github/gitignore/blob/main/community/Golang/Docker.gitignore)
# =============================================================================
docker-compose.override.yml
docker-compose.override.yaml

# =============================================================================
# Editors & IDEs
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/

# Vim
*.swp
*.swo
*~
.netrwhist

# =============================================================================
# OS
# =============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# mkdocs build output
# =============================================================================
site/

# =============================================================================
# MediaMTX recordings (video segments written here at runtime).
# Directory tracked via .gitkeep so the bind mount has a host-owned target
# on first `just up`. Override the host path with MEDIAMTX_RECORDINGS_DIR.
# =============================================================================
/recordings/*
!/recordings/.gitkeep

# =============================================================================
# Capture (mitmproxy traffic inspection).
# Flows contain real auth material (client certs, session tokens); mitm certs
# are extracted under capture/. Track the dirs via .gitkeep so bind mounts have
# host-owned targets on first `just up --capture`.
# =============================================================================
/captures/*
!/captures/.gitkeep
/capture/*
!/capture/.gitkeep
